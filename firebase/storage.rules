rules_version = '2';

// =============================================================================
// Regole Storage – Sistema iscrizioni OTP-GEA (progetto otpgea-iscrizioni)
//
// Percorsi:
//   caricamenti/{uid}/{file}                  file appena caricati dal form
//                                             (accesso anonimo), temporanei
//   eventi/{eventoId}/{iscrizioneId}/{file}   documenti definitivi, spostati
//                                             qui dalla Cloud Function
//
// La verifica degli admin legge Firestore (/admin/{email}): al primo
// salvataggio la console chiede di autorizzare Storage a leggere Firestore.
// =============================================================================

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email is string
        && firestore.exists(/databases/(default)/documents/admin/$(request.auth.token.email.lower()));
    }

    // Immagini (il form le comprime in JPEG) o PDF, massimo 5 MB
    function fileDocumentoValido() {
      return request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png)|application/pdf');
    }

    // ---- Caricamenti temporanei dal form
    // Ognuno scrive solo nella propria cartella (uid dell'accesso anonimo),
    // con nomi file semplici. Nessuna lettura pubblica.
    match /caricamenti/{uid}/{nomeFile} {
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && nomeFile.matches('^[A-Za-z0-9_-]{1,80}[.](jpg|jpeg|png|pdf)$')
        && fileDocumentoValido();
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow read: if isAdmin();
    }

    // ---- Documenti definitivi delle iscrizioni
    match /eventi/{eventoId}/{iscrizioneId}/{nomeFile} {
      allow read: if isAdmin();
      allow delete: if isAdmin();
      allow create, update: if false;   // solo Cloud Functions
    }

    // Qualsiasi altro percorso (compresa la vecchia cartella "iscrizioni/"):
    // nessun accesso.
  }
}
