rules_version = '2';

// =============================================================================
// Regole Firestore – Sistema iscrizioni OTP-GEA (progetto otpgea-iscrizioni)
// Struttura dati descritta in firebase/LEGGIMI.md
//
// Principi:
// - Iscrizioni, prenotazioni di nome/email ed email in uscita sono create SOLO
//   dalle Cloud Functions (Admin SDK, che non è soggetto a queste regole).
// - Gli organizzatori sono elencati nella collezione "admin" (id documento =
//   email in minuscolo). La collezione si modifica solo dalla console Firebase.
// - Tutto ciò che non è esplicitamente consentito è vietato.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- funzioni

    // Utente entrato con email e password ed elencato in /admin
    function isAdmin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email is string
        && exists(/databases/$(database)/documents/admin/$(request.auth.token.email.lower()));
    }

    // Id evento leggibile: minuscole, numeri e trattini (es. piacenza-svelata-2027)
    function idEventoValido(id) {
      return id.size() >= 3 && id.size() <= 60
        && id.matches('^[a-z0-9]+(-[a-z0-9]+)*$');
    }

    // Controllo minimo della forma dell'evento (il resto lo verificano
    // l'editor di ps-admin e la funzione creaIscrizione)
    function eventoValido(d) {
      return d.keys().hasAll(['titolo', 'iscrizioniAperte', 'categorie'])
        && d.titolo is string && d.titolo.size() > 0 && d.titolo.size() <= 200
        && d.iscrizioniAperte is bool
        && d.categorie is list && d.categorie.size() <= 30;
    }

    // Stati ammessi per un'iscrizione
    function statoValido(s) {
      return s in ['in_attesa_pagamento', 'pagata', 'confermata_gratuita', 'annullata'];
    }

    // ------------------------------------------------------------ organizzatori

    match /admin/{email} {
      allow read: if isAdmin();
      allow write: if false;            // solo dalla console Firebase
    }

    // ------------------------------------------------------------------- eventi

    match /eventi/{eventoId} {
      // Configurazione pubblica: serve al form (titolo, categorie, quote,
      // iscrizioni aperte/chiuse). Non mettere qui dati riservati.
      allow read: if true;
      allow create: if isAdmin() && idEventoValido(eventoId) && eventoValido(request.resource.data);
      allow update: if isAdmin() && eventoValido(request.resource.data);
      allow delete: if isAdmin();

      // ---- Iscrizioni dell'evento
      match /iscrizioni/{iscrizioneId} {
        // Admin: tutto in lettura. Chi ha compilato il form (accesso anonimo
        // con lo stesso uid) può leggere SOLO la propria iscrizione, per
        // vedere l'esito del pagamento al ritorno da SumUp.
        allow get: if isAdmin()
          || (request.auth != null && resource.data.uid == request.auth.uid);
        allow list: if isAdmin();

        allow create: if false;         // solo Cloud Function creaIscrizione

        // Admin: può cambiare solo i campi di gestione, non i dati inseriti
        // dall'utente né importo e pagamento.
        allow update: if isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['notaAdmin', 'verifiche', 'emailConfermaInviata',
                         'stato', 'annullataIl', 'aggiornataIl'])
          && statoValido(request.resource.data.stato);

        allow delete: if isAdmin();
      }

      // ---- Prenotazioni nome squadra (id = nome normalizzato)
      // Lettura del singolo documento consentita a tutti: il form avvisa subito
      // se il nome è già preso. Il documento contiene solo la data di creazione.
      match /nomiSquadre/{slug} {
        allow get: if true;
        allow list: if isAdmin();
        allow create, update: if false; // solo Cloud Functions
        allow delete: if isAdmin();     // per liberare un nome a mano
      }

      // ---- Prenotazioni email (id = email normalizzata)
      // Nessuna lettura pubblica: non si deve poter scoprire chi è iscritto.
      match /emailUsate/{emailNorm} {
        allow read: if isAdmin();
        allow create, update: if false; // solo Cloud Functions
        allow delete: if isAdmin();
      }
    }

    // ------------------------------------------------- email (estensione Trigger Email)

    match /mail/{mailId} {
      // Gli admin possono inviare email da ps-admin e vedere l'esito
      // dell'invio (campo "delivery" scritto dall'estensione).
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['to', 'message', 'bcc', 'replyTo'])
        && (request.resource.data.to is string || request.resource.data.to is list)
        && request.resource.data.message is map;
      allow update, delete: if false;
    }

    // Qualsiasi altra collezione (comprese le vecchie "iscrizioni" e
    // "nomiSquadre" in radice): nessun accesso.
  }
}
